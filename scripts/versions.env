# Pinned toolchain and third-party library versions.
# Sourced by the build scripts; keep it plain KEY=value.

# Android NDK used to cross-compile. https://developer.android.com/ndk/downloads
NDK_VERSION=r29

# Target: 64-bit ARM, Android 7.0 (API 24) and newer.
ANDROID_ABI=arm64-v8a
ANDROID_API=24

# protobuf 3.21.x is the last release line that does not need abseil.
# protoc (host) and libprotobuf (target) are both built from this tarball.
PROTOBUF_VERSION=3.21.12
PROTOBUF_URL=https://github.com/protocolbuffers/protobuf/releases/download/v21.12/protobuf-cpp-3.21.12.tar.gz
PROTOBUF_SHA256=4eab9b524aa5913c6fffb20b2a8abf5ef7f95a80bc0701f3a6dbb4c607f73460

BROTLI_VERSION=1.1.0
BROTLI_URL=https://github.com/google/brotli/archive/refs/tags/v1.1.0.tar.gz
BROTLI_SHA256=e720a6ca29428b803f4ad165371771f5398faba397edf6778837a18599ea13ff

LZ4_VERSION=1.10.0
LZ4_URL=https://github.com/lz4/lz4/releases/download/v1.10.0/lz4-1.10.0.tar.gz
LZ4_SHA256=537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b

ZSTD_VERSION=1.5.7
ZSTD_URL=https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz
ZSTD_SHA256=eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3
